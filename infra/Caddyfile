# SITE_ADDRESS is a DuckDNS host name in staging/production (automatic Let's Encrypt TLS)
# and "localhost" in the local rehearsal (Caddy's internal CA).
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; font-src https://fonts.gstatic.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# The Hangfire dashboard is never exposed (Development-only in the API).
	handle /hangfire* {
		respond 404
	}

	# /hubs/* is SignalR (sub-project 2).
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle /hubs/* {
		reverse_proxy api:8080
	}

	# Angular's production build hashes the file names of scripts and styles.
	@hashed path_regexp ^/[^/]+-[A-Za-z0-9]{8}\.(js|css)$
	handle @hashed {
		root * /srv/releases/current/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: static files, falling back to the SPA shell. Always revalidated.
	handle {
		root * /srv/releases/current/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
